# ===============================================
# Algo-Dungeon Environment Variables
# ===============================================

# Frontend Configuration
VITE_BACKEND_URL=http://backend:8000

# Backend Configuration (for upcoming backend container)
PORT=8000
NODE_ENV=development

# Database Configuration (PostgreSQL container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=algo_dungeon
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/algo_dungeon

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=
