  "python": {
    "starterCode": "def subsetsWithDup(nums):\n    return []\n",
    "solutionCode": "def subsetsWithDup(nums):\n    nums.sort()\n    res = []\n    def backtrack(start, curr):\n        res.append(list(curr))\n        for i in range(start, len(nums)):\n            if i > start and nums[i] == nums[i - 1]:\n                continue\n            curr.append(nums[i])\n            backtrack(i + 1, curr)\n            curr.pop()\n    backtrack(0, [])\n    return res\n"
  },
