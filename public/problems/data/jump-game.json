  "hints": [
    "Maintain maxReach = max(maxReach, i + nums[i]). If i > maxReach, you are stuck."
  ],
  "python": {
    "starterCode": "def canJump(nums):\n    return False\n",
    "solutionCode": "def canJump(nums):\n    max_reach = 0\n    for i, jump in enumerate(nums):\n        if i > max_reach:\n            return False\n        max_reach = max(max_reach, i + jump)\n        if max_reach >= len(nums) - 1:\n            return True\n    return True\n"
  },
