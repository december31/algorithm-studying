  "hints": [
    "Maintain sets for occupied columns, positive diagonals (r + c), and negative diagonals (r - c)."
  ],
  "python": {
    "starterCode": "def solveNQueens(n):\n    return []\n",
    "solutionCode": "def solveNQueens(n):\n    res = []\n    cols, diag1, diag2 = set(), set(), set()\n    board = [[\".\"] * n for _ in range(n)]\n    def backtrack(r):\n        if r == n:\n            res.append([\"\".join(row) for row in board])\n            return\n        for c in range(n):\n            if c in cols or (r - c) in diag1 or (r + c) in diag2:\n                continue\n            cols.add(c)\n            diag1.add(r - c)\n            diag2.add(r + c)\n            board[r][c] = \"Q\"\n            backtrack(r + 1)\n            board[r][c] = \".\"\n            cols.remove(c)\n            diag1.remove(r - c)\n            diag2.remove(r + c)\n    backtrack(0)\n    return res\n"
  },
