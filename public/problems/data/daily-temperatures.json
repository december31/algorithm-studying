  "hints": [
    "Maintain a monotonic decreasing stack of indices. Pop when encountering a warmer day."
  ],
  "python": {
    "starterCode": "def dailyTemperatures(temperatures):\n    return [0] * len(temperatures)\n",
    "solutionCode": "def dailyTemperatures(temperatures):\n    n = len(temperatures)\n    res = [0] * n\n    stack = []\n    for i, t in enumerate(temperatures):\n        while stack and t > temperatures[stack[-1]]:\n            prev = stack.pop()\n            res[prev] = i - prev\n        stack.append(i)\n    return res\n"
  },
