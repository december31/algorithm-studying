  "python": {
    "starterCode": "def validPath(n, edges, source, destination):\n    return False\n",
    "solutionCode": "from collections import deque\ndef validPath(n, edges, source, destination):\n    if source == destination:\n        return True\n    adj = [[] for _ in range(n)]\n    for u, v in edges:\n        adj[u].append(v)\n        adj[v].append(u)\n    visited = {source}\n    q = deque([source])\n    while q:\n        curr = q.popleft()\n        if curr == destination:\n            return True\n        for nxt in adj[curr]:\n            if nxt not in visited:\n                visited.add(nxt)\n                q.append(nxt)\n    return False\n"
  },
