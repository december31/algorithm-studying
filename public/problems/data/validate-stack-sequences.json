  "hints": [
    "Simulate the stack push sequence. While the top matches popped[j], pop and increment j."
  ],
  "python": {
    "starterCode": "def validateStackSequences(pushed, popped):\n    return False\n",
    "solutionCode": "def validateStackSequences(pushed, popped):\n    stack = []\n    j = 0\n    for x in pushed:\n        stack.append(x)\n        while stack and j < len(popped) and stack[-1] == popped[j]:\n            stack.pop()\n            j += 1\n    return j == len(popped)\n"
  },
