  "solutionCode": "def rotateImage(matrix: list[list[int]]) -> list[list[int]]:\n    n = len(matrix)\n    for i in range(n):\n        for j in range(i + 1, n):\n            matrix[i][j], matrix[j][i] = matrix[j][i], matrix[i][j]\n    for r in range(n):\n        matrix[r].reverse()\n    return matrix\n",
