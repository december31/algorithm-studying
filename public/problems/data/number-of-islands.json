  "hints": [
    "Iterate through cells. When finding \"1\", increment count and sink all adjacent connected \"1\"s."
  ],
  "python": {
    "starterCode": "def numIslands(grid):\n    return 0\n",
    "solutionCode": "def numIslands(grid):\n    if not grid:\n        return 0\n    m, n = len(grid), len(grid[0])\n    count = 0\n    def sink(r, c):\n        if r < 0 or r >= m or c < 0 or c >= n or grid[r][c] == \"0\":\n            return\n        grid[r][c] = \"0\"\n        sink(r + 1, c)\n        sink(r - 1, c)\n        sink(r, c + 1)\n        sink(r, c - 1)\n    for r in range(m):\n        for c in range(n):\n            if grid[r][c] == \"1\":\n                count += 1\n                sink(r, c)\n    return count\n"
  },
