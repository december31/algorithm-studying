  "description": "The XOR total of an array is defined as the bitwise XOR of all its elements, or 0 if the array is empty.\n\nGiven an array `nums`, return the sum of all XOR totals for every subset of `nums`.",
  "examples": [
    {
      "input": "nums = [1, 3]",
      "output": "6"
    },
    {
      "input": "nums = [5, 1, 6]",
      "output": "28"
    }
  ],
  "constraints": [
    "1 <= nums.length <= 12",
    "1 <= nums[i] <= 20"
  ],
  "starterCode": "function subsetXORSum(nums) {\n  return 0;\n}",
  "solutionCode": "function subsetXORSum(nums) {\n  let total = 0;\n  function backtrack(idx, currentXor) {\n    if (idx === nums.length) {\n      total += currentXor;\n      return;\n    }\n    // Include nums[idx]\n    backtrack(idx + 1, currentXor ^ nums[idx]);\n    // Exclude nums[idx]\n    backtrack(idx + 1, currentXor);\n  }\n  backtrack(0, 0);\n  return total;\n}",
  "functionName": "subsetXORSum",
