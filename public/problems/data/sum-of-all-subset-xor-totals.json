  "hints": [
    "At each element, branch into two choices: include in the XOR total or exclude it."
  ],
  "python": {
    "starterCode": "def subsetXORSum(nums):\n    return 0\n",
    "solutionCode": "def subsetXORSum(nums):\n    total = 0\n    def backtrack(idx, curr):\n        nonlocal total\n        if idx == len(nums):\n            total += curr\n            return\n        backtrack(idx + 1, curr ^ nums[idx])\n        backtrack(idx + 1, curr)\n    backtrack(0, 0)\n    return total\n"
  },
