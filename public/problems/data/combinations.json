  "hints": [
    "Recursively choose next number from start to n, then backtrack."
  ],
  "python": {
    "starterCode": "def combine(n, k):\n    return []\n",
    "solutionCode": "def combine(n, k):\n    res = []\n    def backtrack(start, curr):\n        if len(curr) == k:\n            res.append(list(curr))\n            return\n        for i in range(start, n + 1):\n            curr.append(i)\n            backtrack(i + 1, curr)\n            curr.pop()\n    backtrack(1, [])\n    return res\n"
  },
