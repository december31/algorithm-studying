  "starterCode": "function combine(n, k) {\n  return [];\n}",
  "solutionCode": "function combine(n, k) {\n  const result = [];\n  function backtrack(start, current) {\n    if (current.length === k) {\n      result.push([...current]);\n      return;\n    }\n    for (let i = start; i <= n; i++) {\n      current.push(i);\n      backtrack(i + 1, current);\n      current.pop();\n    }\n  }\n  backtrack(1, []);\n  return result;\n}",
