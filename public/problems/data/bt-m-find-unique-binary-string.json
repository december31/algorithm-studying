  "description": "Given an array of strings `nums` containing `n` unique binary strings each of length `n`, return a binary string of length `n` that does not appear in `nums`.",
  "examples": [
    {
      "input": "nums = [\"01\",\"10\"]",
      "output": "\"11\""
    },
    {
      "input": "nums = [\"00\",\"01\"]",
      "output": "\"10\""
    },
    {
      "input": "nums = [\"111\",\"011\",\"001\"]",
      "output": "\"000\""
    }
  ],
  "constraints": [
    "n == len(nums)",
    "1 <= n <= 16",
    "nums[i].length == n"
  ],
  "starterCode": "def findDifferentBinaryString(nums: list[str]) -> str:\n    pass\n",
  "solutionCode": "def findDifferentBinaryString(nums: list[str]) -> str:\n    return ''.join('1' if nums[i][i] == '0' else '0' for i in range(len(nums)))\n",
  "functionName": "findDifferentBinaryString",
