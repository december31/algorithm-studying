  "description": "Given an integer `n`, return an array `ans` of length `n + 1` such that for each `i` (0 <= i <= n), `ans[i]` is the number of 1's in the binary representation of `i`.",
  "examples": [
    {
      "input": "n = 2",
      "output": "[0,1,1]"
    },
    {
      "input": "n = 5",
      "output": "[0,1,1,2,1,2]"
    }
  ],
  "constraints": [
    "0 <= n <= 10^5"
  ],
  "starterCode": "function countBits(n) {\n  return [];\n}",
  "solutionCode": "function countBits(n) {\n  const ans = new Array(n + 1).fill(0);\n  for (let i = 1; i <= n; i++) {\n    ans[i] = ans[i >> 1] + (i & 1);\n  }\n  return ans;\n}",
