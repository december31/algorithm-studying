  "hints": [
    "Sort by end time. Always keep the interval that finishes earliest to leave maximum room for future intervals."
  ],
  "python": {
    "starterCode": "def eraseOverlapIntervals(intervals):\n    return 0\n",
    "solutionCode": "def eraseOverlapIntervals(intervals):\n    if len(intervals) <= 1:\n        return 0\n    intervals.sort(key=lambda x: x[1])\n    removed = 0\n    prev_end = intervals[0][1]\n    for curr in intervals[1:]:\n        if curr[0] < prev_end:\n            removed += 1\n        else:\n            prev_end = curr[1]\n    return removed\n"
  },
