  "starterCode": "function longestSubarray(nums) {\n  return 0;\n}",
  "solutionCode": "function longestSubarray(nums) {\n  const maxVal = Math.max(...nums);\n  let maxLen = 0;\n  let currentLen = 0;\n  for (const n of nums) {\n    if (n === maxVal) {\n      currentLen++;\n      maxLen = Math.max(maxLen, currentLen);\n    } else {\n      currentLen = 0;\n    }\n  }\n  return maxLen;\n}",
