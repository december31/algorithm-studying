  "hints": [
    "Bitwise AND cannot increase value: a & b <= min(a, b). The maximum AND must be equal to max(nums). Find longest contiguous run of max(nums)."
  ],
  "python": {
    "starterCode": "def longestSubarray(nums):\n    return 0\n",
    "solutionCode": "def longestSubarray(nums):\n    max_val = max(nums)\n    max_len = 0\n    curr_len = 0\n    for n in nums:\n        if n == max_val:\n            curr_len += 1\n            max_len = max(max_len, curr_len)\n        else:\n            curr_len = 0\n    return max_len\n"
  },
