  "starterCode": "function hammingDistance(x, y) {\n  return 0;\n}",
  "solutionCode": "function hammingDistance(x, y) {\n  let xor = x ^ y;\n  let dist = 0;\n  while (xor > 0) {\n    xor &= (xor - 1);\n    dist++;\n  }\n  return dist;\n}",
