      "input": "nums = [-1,0,3,5,9,12], target = 2",
      "output": "-1"
    }
  ],
  "constraints": [
    "1 <= nums.length <= 10^4",
    "-10^4 < nums[i], target < 10^4",
    "All elements in nums are unique and sorted."
  ],
  "starterCode": "function search(nums, target) {\n  return -1;\n}",
  "solutionCode": "function search(nums, target) {\n  let left = 0, right = nums.length - 1;\n  while (left <= right) {\n    const mid = Math.floor((left + right) / 2);\n    if (nums[mid] === target) return mid;\n    if (nums[mid] < target) left = mid + 1;\n    else right = mid - 1;\n  }\n  return -1;\n}",
