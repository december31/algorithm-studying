  "description": "Given two integers `left` and `right` that represent the range `[left, right]`, return the bitwise AND of all numbers in this range, inclusive.",
  "examples": [
    {
      "input": "left = 5, right = 7",
      "output": "4"
    },
    {
      "input": "left = 0, right = 0",
      "output": "0"
    },
    {
      "input": "left = 1, right = 2147483647",
      "output": "0"
    }
  ],
  "constraints": [
    "0 <= left <= right <= 2^31 - 1"
  ],
  "starterCode": "function rangeBitwiseAnd(left, right) {\n  return 0;\n}",
  "solutionCode": "function rangeBitwiseAnd(left, right) {\n  let shift = 0;\n  while (left < right) {\n    left >>= 1;\n    right >>= 1;\n    shift++;\n  }\n  return left << shift;\n}",
