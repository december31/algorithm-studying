  "python": {
    "starterCode": "def missingNumberBit(nums):\n    return 0\n",
    "solutionCode": "def missingNumberBit(nums):\n    xor = len(nums)\n    for i, n in enumerate(nums):\n        xor ^= i ^ n\n    return xor\n"
