  "description": "Given an array `nums` containing `n` distinct numbers in the range `[0, n]`, return the only number in the range that is missing from the array using bitwise XOR.",
  "examples": [
    {
      "input": "nums = [3,0,1]",
      "output": "2"
    },
    {
      "input": "nums = [0,1]",
      "output": "2"
    }
  ],
  "constraints": [
    "n == nums.length",
    "1 <= n <= 10^4",
    "0 <= nums[i] <= n"
  ],
  "starterCode": "function missingNumberBit(nums) {\n  return 0;\n}",
  "solutionCode": "function missingNumberBit(nums) {\n  let xor = nums.length;\n  for (let i = 0; i < nums.length; i++) {\n    xor ^= i ^ nums[i];\n  }\n  return xor;\n}",
