  "python": {
    "starterCode": "def largestAltitude(gain):\n    return 0\n",
    "solutionCode": "def largestAltitude(gain):\n    max_alt = 0\n    curr = 0\n    for g in gain:\n        curr += g\n        max_alt = max(max_alt, curr)\n    return max_alt\n"
