  "starterCode": "function reverseBits(n) {\n  return 0;\n}",
  "solutionCode": "function reverseBits(n) {\n  let result = 0;\n  for (let i = 0; i < 32; i++) {\n    result = (result << 1) | (n & 1);\n    n >>>= 1;\n  }\n  return result >>> 0;\n}",
