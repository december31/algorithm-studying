  "hints": [
    "Push -1 as a base index. On \"(\", push index. On \")\", pop and calculate distance to new top."
  ],
  "python": {
    "starterCode": "def longestValidParentheses(s):\n    return 0\n",
    "solutionCode": "def longestValidParentheses(s):\n    stack = [-1]\n    max_len = 0\n    for i, c in enumerate(s):\n        if c == \"(\":\n            stack.append(i)\n        else:\n            stack.pop()\n            if not stack:\n                stack.append(i)\n            else:\n                max_len = max(max_len, i - stack[-1])\n    return max_len\n"
  },
