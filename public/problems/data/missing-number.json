  "description": "Given an array `nums` containing `n` distinct numbers in the range `[0, n]`, return the only number in the range that is missing from the array.",
  "examples": [
    {
      "input": "nums = [3, 0, 1]",
      "output": "2"
    },
    {
      "input": "nums = [0, 1]",
      "output": "2"
    },
    {
      "input": "nums = [9, 6, 4, 2, 3, 5, 7, 0, 1]",
      "output": "8"
    }
  ],
  "constraints": [
    "n == nums.length",
    "1 <= n <= 10^4",
    "0 <= nums[i] <= n",
    "All numbers in nums are unique."
  ],
  "starterCode": "function missingNumber(nums) {\n  return 0;\n}",
  "solutionCode": "function missingNumber(nums) {\n  const n = nums.length;\n  const expectedSum = (n * (n + 1)) / 2;\n  const actualSum = nums.reduce((a, b) => a + b, 0);\n  return expectedSum - actualSum;\n}",
