  "hints": [
    "Precompute counts of (nums[i] & nums[j]) in a table of size 2^16, reducing O(n^3) to O(n^2 + 2^16 * n)."
  ],
  "python": {
    "starterCode": "def countTriplets(nums):\n    return 0\n",
    "solutionCode": "def countTriplets(nums):\n    pair_count = [0] * (1 << 16)\n    for a in nums:\n        for b in nums:\n            pair_count[a & b] += 1\n    ans = 0\n    for c in nums:\n        for pair in range(1 << 16):\n            if (c & pair) == 0:\n                ans += pair_count[pair]\n    return ans\n"
  },
