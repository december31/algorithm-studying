  "starterCode": "function firstUniqChar(s) {\n  return -1;\n}",
  "solutionCode": "function firstUniqChar(s) {\n  const count = {};\n  for (const c of s) count[c] = (count[c] || 0) + 1;\n  for (let i = 0; i < s.length; i++) {\n    if (count[s[i]] === 1) return i;\n  }\n  return -1;\n}",
