  "python": {
    "starterCode": "def permute(nums):\n    return []\n",
    "solutionCode": "def permute(nums):\n    res = []\n    used = [False] * len(nums)\n    def backtrack(curr):\n        if len(curr) == len(nums):\n            res.append(list(curr))\n            return\n        for i in range(len(nums)):\n            if not used[i]:\n                used[i] = True\n                curr.append(nums[i])\n                backtrack(curr)\n                curr.pop()\n                used[i] = False\n    backtrack([])\n    return res\n"
  },
