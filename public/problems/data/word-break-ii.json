  "hints": [
    "DFS from the start of the string, matching any prefix that exists in the dictionary. Memoize results for each suffix string to avoid repeated work."
  ],
  "python": {
    "starterCode": "def wordBreak(s, wordDict):\n    return []\n",
    "solutionCode": "def wordBreak(s, wordDict):\n    d = set(wordDict)\n    memo = {}\n    def dfs(rem):\n        if rem in memo:\n            return memo[rem]\n        if not rem:\n            return [\"\"]\n        res = []\n        for word in wordDict:\n            if rem.startswith(word):\n                sub_res = dfs(rem[len(word):])\n                for sub in sub_res:\n                    res.append(word if not sub else word + \" \" + sub)\n        memo[rem] = res\n        return res\n    return dfs(s)\n"
  },
