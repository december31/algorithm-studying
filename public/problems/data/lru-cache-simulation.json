  "hints": [
    "JavaScript Map preserves insertion order. Deleting and re-setting an entry moves it to the most-recent end."
  ],
  "python": {
    "starterCode": "def getLruOrder(ops, cap):\n    return []\n",
    "solutionCode": "def getLruOrder(ops, cap):\n    cache = {}\n    for item in ops:\n        if item in cache:\n            del cache[item]\n        elif len(cache) >= cap:\n            oldest = next(iter(cache))\n            del cache[oldest]\n        cache[item] = True\n    return list(reversed(list(cache.keys())))\n"
  },
