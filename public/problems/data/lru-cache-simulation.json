  "description": "Given a sequence of cache operations `ops` and a maximum capacity `cap`, return the list of items remaining in the LRU cache ordered from most recently used to least recently used.",
  "examples": [
    {
      "input": "ops = [\"A\", \"B\", \"C\", \"A\", \"D\"], cap = 3",
      "output": "[\"D\", \"A\", \"C\"]"
    }
  ],
  "constraints": [
    "1 <= cap <= 1000",
    "1 <= ops.length <= 10^4"
  ],
  "starterCode": "function getLruOrder(ops, cap) {\n  return [];\n}",
  "solutionCode": "function getLruOrder(ops, cap) {\n  const map = new Map();\n  for (const item of ops) {\n    if (map.has(item)) {\n      map.delete(item);\n    } else if (map.size >= cap) {\n      const oldest = map.keys().next().value;\n      map.delete(oldest);\n    }\n    map.set(item, true);\n  }\n  return Array.from(map.keys()).reverse();\n}",
  "functionName": "getLruOrder",
