    {
      "input": "nums = [1, 2, 3, 1]",
      "output": "true"
    },
    {
      "input": "nums = [1, 2, 3, 4]",
      "output": "false"
    },
    {
      "input": "nums = [1, 1, 1, 3, 3, 4, 3, 2, 4, 2]",
      "output": "true"
    }
  ],
  "constraints": [
    "1 <= nums.length <= 10^5",
    "-10^9 <= nums[i] <= 10^9"
  ],
  "starterCode": "function containsDuplicate(nums) {\n  return false;\n}",
  "solutionCode": "function containsDuplicate(nums) {\n  return new Set(nums).size !== nums.length;\n}",
