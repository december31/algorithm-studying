  "description": "Given the root of a binary tree, return its maximum depth. A binary tree's maximum depth is the number of nodes along the longest path from the root node down to the farthest leaf node.",
  "examples": [
    {
      "input": "root = [3, 9, 20, null, null, 15, 7]",
      "output": "3"
    },
    {
      "input": "root = [1, null, 2]",
      "output": "2"
    }
  ],
  "constraints": [
    "The number of nodes in the tree is in the range [0, 10^4].",
    "-100 <= Node.val <= 100"
  ],
  "starterCode": "function maxDepth(root) {\n  return 0;\n}",
  "solutionCode": "function maxDepth(root) {\n  if (!root || root.length === 0 || root[0] === null) return 0;\n  function getDepth(idx) {\n    if (idx >= root.length || root[idx] === null || root[idx] === undefined) return 0;\n    return 1 + Math.max(getDepth(2 * idx + 1), getDepth(2 * idx + 2));\n  }\n  return getDepth(0);\n}",
  "functionName": "maxDepth",
