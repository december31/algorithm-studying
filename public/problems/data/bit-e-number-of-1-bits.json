  "starterCode": "def hammingWeight(n: int) -> int:\n    pass\n",
  "solutionCode": "def hammingWeight(n: int) -> int:\n    count = 0\n    while n > 0:\n        n &= (n - 1)\n        count += 1\n    return count\n",
