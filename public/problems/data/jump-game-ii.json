  "python": {
    "starterCode": "def jump(nums):\n    return 0\n",
    "solutionCode": "def jump(nums):\n    jumps, curr_end, farthest = 0, 0, 0\n    for i in range(len(nums) - 1):\n        farthest = max(farthest, i + nums[i])\n        if i == curr_end:\n            jumps += 1\n            curr_end = farthest\n    return jumps\n"
