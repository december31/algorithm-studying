  "python": {
    "starterCode": "def isUnivalTree(root):\n    return True\n",
    "solutionCode": "def isUnivalTree(root):\n    if not root or root[0] is None:\n        return True\n    val = root[0]\n    return all(x is None or x == val for x in root)\n"
