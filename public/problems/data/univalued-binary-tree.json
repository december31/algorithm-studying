  "description": "A binary tree is uni-valued if every node in the tree has the same value. Given the root of a binary tree, return `true` if the given tree is uni-valued, or `false` otherwise.",
  "examples": [
    {
      "input": "root = [1, 1, 1, 1, 1, null, 1]",
      "output": "true"
    },
    {
      "input": "root = [2, 2, 2, 5, 2]",
      "output": "false"
    }
  ],
  "constraints": [
    "The number of nodes in the tree is in the range [1, 100]."
  ],
  "starterCode": "function isUnivalTree(root) {\n  return true;\n}",
  "solutionCode": "function isUnivalTree(root) {\n  if (!root || root.length === 0 || root[0] === null) return true;\n  const val = root[0];\n  for (let i = 0; i < root.length; i++) {\n    if (root[i] !== null && root[i] !== undefined && root[i] !== val) return false;\n  }\n  return true;\n}",
  "functionName": "isUnivalTree",
