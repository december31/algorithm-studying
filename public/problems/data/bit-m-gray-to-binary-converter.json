  "description": "Given a non-negative integer `gray` representing an n-bit Gray code value, return its corresponding standard binary integer representation.",
  "examples": [
    {
      "input": "gray = 3",
      "output": "2"
    },
    {
      "input": "gray = 6",
      "output": "4"
    },
    {
      "input": "gray = 0",
      "output": "0"
    }
  ],
  "constraints": [
    "0 <= gray <= 2^31 - 1"
  ],
  "starterCode": "def grayToBinary(gray: int) -> int:\n    pass\n",
  "solutionCode": "def grayToBinary(gray: int) -> int:\n    binary = 0\n    while gray > 0:\n        binary ^= gray\n        gray >>= 1\n    return binary\n",
