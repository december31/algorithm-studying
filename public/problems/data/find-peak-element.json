  "description": "A peak element is an element that is strictly greater than its neighbors. Given an integer array `nums`, find a peak element, and return its index. If the array contains multiple peaks, return the index to any of the peaks. Must run in O(log n).",
  "examples": [
    {
      "input": "nums = [1,2,3,1]",
      "output": "2"
    },
    {
      "input": "nums = [1,2,1,3,5,6,4]",
      "output": "5"
    }
  ],
  "constraints": [
    "1 <= nums.length <= 1000",
    "-2^31 <= nums[i] <= 2^31 - 1"
  ],
  "starterCode": "function findPeakElement(nums) {\n  return 0;\n}",
  "solutionCode": "function findPeakElement(nums) {\n  let left = 0, right = nums.length - 1;\n  while (left < right) {\n    const mid = Math.floor((left + right) / 2);\n    if (nums[mid] < nums[mid + 1]) {\n      left = mid + 1; // rising slope: peak must exist to the right\n    } else {\n      right = mid; // falling slope: peak is at mid or to the left\n    }\n  }\n  return left;\n}",
