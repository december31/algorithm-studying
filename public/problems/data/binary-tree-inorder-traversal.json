  "python": {
    "starterCode": "def inorderTraversal(root):\n    return []\n",
    "solutionCode": "def inorderTraversal(root):\n    if not root or root[0] is None:\n        return []\n    res = []\n    def traverse(idx):\n        if idx >= len(root) or root[idx] is None:\n            return\n        traverse(2 * idx + 1)\n        res.append(root[idx])\n        traverse(2 * idx + 2)\n    traverse(0)\n    return res\n"
  },
