    "-10 <= nums[i] <= 10",
    "All elements of nums are unique."
  ],
  "starterCode": "function subsets(nums) {\n  return [];\n}",
  "solutionCode": "function subsets(nums) {\n  const result = [];\n  function backtrack(start, current) {\n    result.push([...current]);\n    for (let i = start; i < nums.length; i++) {\n      current.push(nums[i]);\n      backtrack(i + 1, current);\n      current.pop();\n    }\n  }\n  backtrack(0, []);\n  return result;\n}",
