  "python": {
    "starterCode": "def subsets(nums):\n    return []\n",
    "solutionCode": "def subsets(nums):\n    res = []\n    def backtrack(start, curr):\n        res.append(list(curr))\n        for i in range(start, len(nums)):\n            curr.append(nums[i])\n            backtrack(i + 1, curr)\n            curr.pop()\n    backtrack(0, [])\n    return res\n"
  },
