  "python": {
    "starterCode": "def mergeIntervals(intervals):\n    return []\n",
    "solutionCode": "def mergeIntervals(intervals):\n    if len(intervals) <= 1:\n        return intervals\n    intervals.sort(key=lambda x: x[0])\n    res = [intervals[0]]\n    for curr in intervals[1:]:\n        if curr[0] <= res[-1][1]:\n            res[-1][1] = max(res[-1][1], curr[1])\n        else:\n            res.append(curr)\n    return res\n"
  },
