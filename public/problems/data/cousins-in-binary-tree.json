  "description": "In a binary tree, the root node is at depth 0. Two nodes of a binary tree are cousins if they have the same depth with different parents. Return `true` if `x` and `y` are cousins.",
  "examples": [
    {
      "input": "root = [1, 2, 3, 4], x = 4, y = 3",
      "output": "false"
    },
    {
      "input": "root = [1, 2, 3, null, 4, null, 5], x = 5, y = 4",
      "output": "true"
    }
  ],
  "constraints": [
    "The number of nodes in the tree will be between 2 and 100."
  ],
  "starterCode": "function isCousins(root, x, y) {\n  return false;\n}",
  "solutionCode": "function isCousins(root, x, y) {\n  let xInfo = null, yInfo = null;\n  function dfs(idx, depth, parent) {\n    if (idx >= root.length || root[idx] === null || root[idx] === undefined) return;\n    const val = root[idx];\n    if (val === x) xInfo = { depth, parent };\n    if (val === y) yInfo = { depth, parent };\n    dfs(2 * idx + 1, depth + 1, val);\n    dfs(2 * idx + 2, depth + 1, val);\n  }\n  dfs(0, 0, null);\n  return xInfo && yInfo && xInfo.depth === yInfo.depth && xInfo.parent !== yInfo.parent;\n}",
  "functionName": "isCousins",
