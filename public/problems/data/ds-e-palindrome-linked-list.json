  "description": "Given an array `head` of values representing a linked list, return `True` if the sequence is a palindrome, or `False` otherwise.",
  "examples": [
    {
      "input": "head = [1,2,2,1]",
      "output": "True"
    },
    {
      "input": "head = [1,2]",
      "output": "False"
    }
  ],
  "constraints": [
    "1 <= len(head) <= 10^5",
    "0 <= head[i] <= 9"
  ],
  "starterCode": "def isPalindromeList(head: list[int]) -> bool:\n    pass\n",
  "solutionCode": "def isPalindromeList(head: list[int]) -> bool:\n    left = 0\n    right = len(head) - 1\n    while left < right:\n        if head[left] != head[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\n",
