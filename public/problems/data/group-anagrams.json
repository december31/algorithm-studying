  "hints": [
    "Sort each word alphabetically to use as the hash map key."
  ],
  "python": {
    "starterCode": "def groupAnagrams(strs):\n    return []\n",
    "solutionCode": "def groupAnagrams(strs):\n    groups = {}\n    for s in strs:\n        key = \"\".join(sorted(s))\n        if key not in groups:\n            groups[key] = []\n        groups[key].append(s)\n    return list(groups.values())\n"
  },
