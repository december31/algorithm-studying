  "python": {
    "starterCode": "def islandPerimeter(grid):\n    return 0\n",
    "solutionCode": "def islandPerimeter(grid):\n    m, n = len(grid), len(grid[0])\n    perimeter = 0\n    for r in range(m):\n        for c in range(n):\n            if grid[r][c] == 1:\n                perimeter += 4\n                if r > 0 and grid[r - 1][c] == 1:\n                    perimeter -= 2\n                if c > 0 and grid[r][c - 1] == 1:\n                    perimeter -= 2\n    return perimeter\n"
  },
