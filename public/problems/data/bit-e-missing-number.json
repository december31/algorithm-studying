  "starterCode": "def missingNumber(nums: list[int]) -> int:\n    pass\n",
  "solutionCode": "def missingNumber(nums: list[int]) -> int:\n    ans = len(nums)\n    for i, x in enumerate(nums):\n        ans ^= i ^ x\n    return ans\n",
