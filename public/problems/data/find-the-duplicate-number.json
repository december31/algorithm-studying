  "hints": [
    "Treat the array indices and values as a linked list (i -> nums[i]). Since a number is duplicated, a cycle exists. Use Floyd's Tortoise and Hare."
  ],
  "python": {
    "starterCode": "def findDuplicate(nums):\n    return 0\n",
    "solutionCode": "def findDuplicate(nums):\n    slow, fast = nums[0], nums[0]\n    while True:\n        slow = nums[slow]\n        fast = nums[nums[fast]]\n        if slow == fast:\n            break\n    slow = nums[0]\n    while slow != fast:\n        slow = nums[slow]\n        fast = nums[fast]\n    return slow\n"
  },
