  "hints": [
    "Sort both arrays. Satisfy the child with the smallest greed factor using the smallest viable cookie."
  ],
  "python": {
    "starterCode": "def findContentChildren(g, s):\n    return 0\n",
    "solutionCode": "def findContentChildren(g, s):\n    g.sort()\n    s.sort()\n    child, cookie = 0, 0\n    while child < len(g) and cookie < len(s):\n        if s[cookie] >= g[child]:\n            child += 1\n        cookie += 1\n    return child\n"
  },
