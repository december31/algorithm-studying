  "description": "Assume you are an awesome parent and want to give your children some cookies. Each child `i` has a greed factor `g[i]`, and each cookie `j` has a size `s[j]`. If `s[j] >= g[i]`, we can assign cookie `j` to child `i`. Maximize the number of content children.",
  "examples": [
    {
      "input": "g = [1,2,3], s = [1,1]",
      "output": "1"
    },
    {
      "input": "g = [1,2], s = [1,2,3]",
      "output": "2"
    }
  ],
  "constraints": [
    "1 <= g.length <= 3 * 10^4",
    "0 <= s.length <= 3 * 10^4",
    "1 <= g[i], s[j] <= 2^31 - 1"
  ],
  "starterCode": "function findContentChildren(g, s) {\n  return 0;\n}",
  "solutionCode": "function findContentChildren(g, s) {\n  g.sort((a, b) => a - b);\n  s.sort((a, b) => a - b);\n  let child = 0, cookie = 0;\n  while (child < g.length && cookie < s.length) {\n    if (s[cookie] >= g[child]) {\n      child++;\n    }\n    cookie++;\n  }\n  return child;\n}",
  "functionName": "findContentChildren",
