  "hints": [
    "Push opening brackets to stack; on closing bracket, pop and ensure matching pair."
  ],
  "python": {
    "starterCode": "def isValid(s):\n    return True\n",
    "solutionCode": "def isValid(s):\n    stack = []\n    mapping = {\")\": \"(\", \"}\": \"{\", \"]\": \"[\"}\n    for char in s:\n        if char in mapping.values():\n            stack.append(char)\n        elif char in mapping:\n            if not stack or stack.pop() != mapping[char]:\n                return False\n    return not stack\n"
  },
