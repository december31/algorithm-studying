  "description": "Given a string `s` containing just the characters '(', ')', '{', '}', '[' and ']', determine if the input string is valid.\n\nOpen brackets must be closed by the same type of brackets in the correct LIFO order.",
  "examples": [
    {
      "input": "s = \"()\"",
      "output": "true"
    },
    {
      "input": "s = \"()[]{}\"",
      "output": "true"
    },
    {
      "input": "s = \"(]\"",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= s.length <= 10^4",
    "s consists of parentheses only '()[]{}'."
  ],
  "starterCode": "function isValid(s) {\n  return true;\n}",
  "solutionCode": "function isValid(s) {\n  const stack = [];\n  const map = { ')': '(', '}': '{', ']': '[' };\n  for (const c of s) {\n    if (c === '(' || c === '{' || c === '[') {\n      stack.push(c);\n    } else {\n      if (stack.length === 0 || stack.pop() !== map[c]) return false;\n    }\n  }\n  return stack.length === 0;\n}",
  "functionName": "isValid",
