  "hints": [
    "Store previously seen values in a Hash Map to look up complements in O(1) time."
  ],
  "python": {
    "starterCode": "def twoSum(nums, target):\n    return []\n",
    "solutionCode": "def twoSum(nums, target):\n    seen = {}\n    for i, num in enumerate(nums):\n        comp = target - num\n        if comp in seen:\n            return [seen[comp], i]\n        seen[num] = i\n    return []\n"
  },
