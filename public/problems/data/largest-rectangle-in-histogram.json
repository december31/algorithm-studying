  "hints": [
    "Maintain an increasing monotonic stack of indices. When a shorter bar appears, pop and compute area with height of popped bar."
  ],
  "python": {
    "starterCode": "def largestRectangleArea(heights):\n    return 0\n",
    "solutionCode": "def largestRectangleArea(heights):\n    stack = []\n    max_area = 0\n    ext = heights + [0]\n    for i, h in enumerate(ext):\n        while stack and h < ext[stack[-1]]:\n            top_h = ext[stack.pop()]\n            w = i if not stack else i - stack[-1] - 1\n            max_area = max(max_area, top_h * w)\n        stack.append(i)\n    return max_area\n"
  },
