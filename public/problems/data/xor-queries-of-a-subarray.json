  "hints": [
    "Compute prefix XOR: prefix[i] = prefix[i-1] ^ arr[i]. Then range XOR(L..R) = prefix[R+1] ^ prefix[L]."
  ],
  "python": {
    "starterCode": "def xorQueries(arr, queries):\n    return []\n",
    "solutionCode": "def xorQueries(arr, queries):\n    prefix = [0] * (len(arr) + 1)\n    for i, n in enumerate(arr):\n        prefix[i + 1] = prefix[i] ^ n\n    return [prefix[r + 1] ^ prefix[l] for l, r in queries]\n"
  },
