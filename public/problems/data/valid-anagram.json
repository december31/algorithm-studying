  "description": "Given two strings `s` and `t`, return `true` if `t` is an anagram of `s`, and `false` otherwise.\n\nAn Anagram is a word or phrase formed by rearranging the letters of a different word or phrase.",
  "examples": [
    {
      "input": "s = \"anagram\", t = \"nagaram\"",
      "output": "true"
    },
    {
      "input": "s = \"rat\", t = \"car\"",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= s.length, t.length <= 5 * 10^4",
    "s and t consist of lowercase English letters."
  ],
  "starterCode": "function isAnagram(s, t) {\n  return false;\n}",
  "solutionCode": "function isAnagram(s, t) {\n  if (s.length !== t.length) return false;\n  const count = {};\n  for (const c of s) count[c] = (count[c] || 0) + 1;\n  for (const c of t) {\n    if (!count[c]) return false;\n    count[c]--;\n  }\n  return true;\n}",
  "functionName": "isAnagram",
