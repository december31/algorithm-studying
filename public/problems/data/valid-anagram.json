  "hints": [
    "Count character frequencies of s in a hash map, then decrement with t."
  ],
  "python": {
    "starterCode": "def isAnagram(s, t):\n    return False\n",
    "solutionCode": "def isAnagram(s, t):\n    if len(s) != len(t):\n        return False\n    count = {}\n    for c in s:\n        count[c] = count.get(c, 0) + 1\n    for c in t:\n        if c not in count or count[c] == 0:\n            return False\n        count[c] -= 1\n    return True\n"
  },
