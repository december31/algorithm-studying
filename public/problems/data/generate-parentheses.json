  "description": "Given `n` pairs of parentheses, write a function to generate all combinations of well-formed parentheses.",
  "examples": [
    {
      "input": "n = 3",
      "output": "[\"((()))\",\"(()())\",\"(())()\",\"()(())\",\"()()()\"]"
    },
    {
      "input": "n = 1",
      "output": "[\"()\"]"
    }
  ],
  "constraints": [
    "1 <= n <= 8"
  ],
  "starterCode": "function generateParenthesis(n) {\n  return [];\n}",
  "solutionCode": "function generateParenthesis(n) {\n  const result = [];\n  function backtrack(open, close, current) {\n    if (current.length === 2 * n) {\n      result.push(current);\n      return;\n    }\n    if (open < n) backtrack(open + 1, close, current + '(');\n    if (close < open) backtrack(open, close + 1, current + ')');\n  }\n  backtrack(0, 0, '');\n  return result;\n}",
  "functionName": "generateParenthesis",
