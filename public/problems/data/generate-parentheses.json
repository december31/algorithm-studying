  "python": {
    "starterCode": "def generateParenthesis(n):\n    return []\n",
    "solutionCode": "def generateParenthesis(n):\n    res = []\n    def backtrack(open_c, close_c, curr):\n        if len(curr) == 2 * n:\n            res.append(curr)\n            return\n        if open_c < n:\n            backtrack(open_c + 1, close_c, curr + \"(\")\n        if close_c < open_c:\n            backtrack(open_c, close_c + 1, curr + \")\")\n    backtrack(0, 0, \"\")\n    return res\n"
  },
