    {
      "input": "prices = [7,6,4,3,1]",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= prices.length <= 10^5",
    "0 <= prices[i] <= 10^4"
  ],
  "starterCode": "function maxProfit(prices) {\n  return 0;\n}",
  "solutionCode": "function maxProfit(prices) {\n  let minPrice = Infinity;\n  let maxProfit = 0;\n  for (const p of prices) {\n    if (p < minPrice) minPrice = p;\n    else if (p - minPrice > maxProfit) maxProfit = p - minPrice;\n  }\n  return maxProfit;\n}",
