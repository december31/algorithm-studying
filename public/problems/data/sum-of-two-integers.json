  "hints": [
    "XOR computes the sum without carry (a ^ b). AND shifted left computes carry ((a & b) << 1)."
  ],
  "python": {
    "starterCode": "def getSum(a, b):\n    return 0\n",
    "solutionCode": "def getSum(a, b):\n    mask = 0xFFFFFFFF\n    while (b & mask) > 0:\n        carry = (a & b) << 1\n        a = a ^ b\n        b = carry\n    return (a & mask) if b > 0 else a\n"
  },
