  "hints": [
    "Store indices in a double-ended queue. Maintain decreasing element values so the front always holds the current window maximum."
  ],
  "python": {
    "starterCode": "def maxSlidingWindow(nums, k):\n    return []\n",
    "solutionCode": "from collections import deque\ndef maxSlidingWindow(nums, k):\n    q = deque()\n    res = []\n    for i, n in enumerate(nums):\n        while q and q[0] <= i - k:\n            q.popleft()\n        while q and nums[q[-1]] <= n:\n            q.pop()\n        q.append(i)\n        if i >= k - 1:\n            res.append(nums[q[0]])\n    return res\n"
  },
