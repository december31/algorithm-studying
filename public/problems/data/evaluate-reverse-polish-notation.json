  "hints": [
    "Push numbers to stack. When hitting an operator, pop two operands, compute, and push result."
  ],
  "python": {
    "starterCode": "def evalRPN(tokens):\n    return 0\n",
    "solutionCode": "def evalRPN(tokens):\n    stack = []\n    for t in tokens:\n        if t in \"+-*/\":\n            b = stack.pop()\n            a = stack.pop()\n            if t == \"+\": stack.append(a + b)\n            elif t == \"-\": stack.append(a - b)\n            elif t == \"*\": stack.append(a * b)\n            elif t == \"/\": stack.append(int(a / b))\n        else:\n            stack.append(int(t))\n    return stack[0]\n"
  },
